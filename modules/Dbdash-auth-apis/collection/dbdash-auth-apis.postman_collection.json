              "// If a var is not set in the environment, set it here.",
              "const defaults = {",
              "  base_url: 'https://dev-api.viasocket.com',",
              "  proxy_auth_token: 'RCt4NytZdzRmVjI5RzNiYXd1bGFYMXU0aGQyOTB1anRxYzVjYjhPSiswQ1A4ZGdVNi95LzlZc1lGa3Y0UDAyV3htdU5lMmJsams4QkpFWXBPZ0dCOWt6NlVZTXFueUhRU2tnYWo2UXZqMVRJbzYrRXJKaERRUUNqWE9GVDd2SkRTU3RweWRDTUQ2NmFId0lTRXBpMFJrN2xyWEV3ZGV1YXJaSTIyU09lejY2OHdIMEdFbGFvV25WQWtvaXQwZHN4',",
              "  orgId: '19014',",
              "  serviceName: 'gmail',",
              "  scriptId: 'scriSkzvvlsa',",
              "  mobile: '+919876543210',",
              "  page_name: 'home_page',",
              "  req_id: 'req1LTcoUcH',",
              "  tableId: 'tbl1j7rk3',",
              "  tableName: 'action',",
              "  pluginRecordId: 'slack',",
              "  query: 'gmail',",
              "  serviceNames: '[\"gmail\",\"slack\"]',",
              "  actionsArr: '[\"row8gjpfv\"]',",
              "  body: '{}'",
              "};",
              "Object.keys(defaults).forEach((k) => {",
              "  if (!pm.variables.get(k)) pm.variables.set(k, defaults[k]);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expectedStatus = Number(pm.iterationData.get('expectedStatus') || pm.variables.get('expectedStatus') || 200);",
              "",
              "pm.test(`Status code is ${expectedStatus}`, () => {",
              "  pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "pm.test('Response time < 30s', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(30000);",
              "});",
              "",
              "if (expectedStatus >= 200 && expectedStatus < 300) {",
              "  pm.test('Response is JSON', () => { pm.response.to.be.json; });",
              "} else {",
              "  pm.test('Error response has message', () => {",
              "    try {",
              "      const body = pm.response.json();",
              "      pm.expect(body.message || body.error || body).to.exist;",
              "    } catch (e) {",
              "      pm.expect(pm.response.text()).to.exist;",
              "    }",
              "  });",
              "}"
            ]
          }
        }
