        {
          "name": "Get Plugin",
          "request": {
            "method": "GET",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/dbdash/getplugin",
              "host": ["{{base_url}}"],
              "path": ["dbdash", "getplugin"]
            }
          },
          "response": []
        },
