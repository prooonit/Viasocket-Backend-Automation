  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Independent suite setup. Controlled by iterationData.setup:",
          "// none | script | functionStep | activeFunctionStep | inactiveFunctionStep |",
          "// deletedFunctionStep | ifBlockStep | twoFunctionSteps | webhookTrigger | preprocess",
          "const setup = pm.iterationData.get(\"setup\") || \"none\";",
          "if (setup === \"none\") { return; }",
          "",
          "const baseUrl = pm.environment.get(\"BASE_URL\");",
          "const token = pm.environment.get(\"proxy_auth_token\");",
          "const projectId = pm.environment.get(\"project_id\");",
          "const orgId = pm.environment.get(\"org_id\");",
          "const headers = { \"proxy_auth_token\": token, \"Content-Type\": \"application/json\" };",
          "",
          "function rand(n) { return Math.random().toString(36).substring(2, 2 + n); }",
          "function newScriptId() { return \"scri\" + rand(8); }",
          "function newStepId() { return \"func\" + rand(8); }",
          "function sanitize(s) {",
          "  return String(s || \"\")",
          "    .replace(/[^a-zA-Z0-9]+/g, \"_\")",
          "    .replace(/^_+|_+$/g, \"\")",
          "    .substring(0, 40) || \"Case\";",
          "}",
          "function requestLabel() {",
          "  return sanitize(pm.info.requestName || \"Request\");",
          "}",
          "function caseLabel() {",
          "  return sanitize(pm.iterationData.get(\"case\") || pm.iterationData.get(\"setup\") || \"setup\");",
          "}",
          "function depScriptTitle() {",
          "  // Identifiable dependency script: Dep_<API>_<case>",
          "  return [\"Dep\", requestLabel(), caseLabel()].join(\"_\");",
          "}",
          "function newTitle(prefix) {",
          "  return [sanitize(prefix || \"Step\"), caseLabel(), rand(4)].join(\"_\");",
          "}",
          "",
          "function parseId(res, fallback) {",
          "  try {",
          "    const j = res.json();",
          "    return j?.data?.identifier || j?.data?.id || j?.script?.id || j?.data?.script?.id || fallback;",
          "  } catch (e) { return fallback; }",
          "}",
          "",
          "function createScript(done) {",
          "  // Reuse one script only for setup=script (create-step / trigger / memory suites).",
          "  // Step-based setups always get a fresh scri* script so fixed titles never collide.",
          "  const canReuse = setup === \"script\" && pm.variables.get(\"_fxScriptReady\") === \"1\" && !pm.iterationData.get(\"freshScript\");",
          "  if (canReuse) {",
          "    return done(pm.variables.get(\"scriptId\"));",
          "  }",
          "  const scriptId = newScriptId();",
          "  const title = depScriptTitle();",
          "  pm.variables.set(\"scriptTitle\", title);",
          "  pm.sendRequest({",
          "    url: baseUrl + \"/projects/\" + projectId + \"/scripts\",",
          "    method: \"POST\",",
          "    header: headers,",
          "    body: { mode: \"raw\", raw: JSON.stringify({ title: title, identifier: scriptId }) }",
          "  }, function (err, res) {",
          "    const id = parseId(res, scriptId);",
          "    pm.variables.set(\"scriptId\", id);",
          "    pm.environment.set(\"scriptId\", id);",
          "    pm.variables.set(\"_fxScriptReady\", \"1\");",
          "    console.log(\"[setup] createScript for\", requestLabel(), \"case=\", caseLabel(), \"title=\", title, \"id=\", id, \"status=\", res && res.code);",
          "    done(id);",
          "  });",
          "}",
          "",
          "function createStep(scriptId, opts, done) {",
          "  const stepId = opts.stepId || newStepId();",
          "  const title = opts.title || newTitle(opts.prefix || \"Step\");",
          "  const type = opts.type || \"function\";",
          "  pm.sendRequest({",
          "    url: baseUrl + \"/scripts/\" + projectId + \"/\" + scriptId + \"/stepv2\",",
          "    method: \"POST\",",
          "    header: headers,",
          "    body: { mode: \"raw\", raw: JSON.stringify({ type: type, title: title, orderGroup: \"root\", scriptId: scriptId, stepId: stepId }) }",
          "  }, function (err, res) {",
          "    console.log(\"[setup] step\", title, stepId, res && res.code);",
          "    done({ stepId: stepId, title: title, type: type });",
          "  });",
          "}",
          "",
          "function updateStep(scriptId, step, code, done) {",
          "  pm.sendRequest({",
          "    url: baseUrl + \"/scripts/\" + scriptId + \"/stepv2/\" + encodeURIComponent(step.title),",
          "    method: \"PUT\",",
          "    header: headers,",
          "    body: { mode: \"raw\", raw: JSON.stringify({",
          "      type: step.type || \"function\",",
          "      title: step.title,",
          "      code: code || \"return true\",",
          "      stepId: step.stepId,",
          "      org_id: orgId,",
          "      project_id: projectId,",
          "      calculateDetailedVariables: false",
          "    }) }",
          "  }, function (err, res) {",
          "    console.log(\"[setup] update\", step.title, res && res.code);",
          "    done();",
          "  });",
          "}",
          "",
          "function changeStatus(scriptId, slug, status, done) {",
          "  pm.sendRequest({",
          "    url: baseUrl + \"/scripts/\" + scriptId + \"/stepv2/\" + encodeURIComponent(slug) + \"/changestatus\",",
          "    method: \"PUT\",",
          "    header: headers,",
          "    body: { mode: \"raw\", raw: JSON.stringify({ status: status, scriptId: scriptId, slugName: slug }) }",
          "  }, function (err, res) {",
          "    console.log(\"[setup] status\", slug, status, res && res.code);",
          "    done();",
          "  });",
          "}",
          "",
          "function deleteStep(scriptId, slug, done) {",
          "  const newTitle = slug + \"_DELETED_\" + Date.now();",
          "  pm.sendRequest({",
          "    url: baseUrl + \"/scripts/\" + scriptId + \"/stepv2/\" + encodeURIComponent(slug),",
          "    method: \"DELETE\",",
          "    header: headers,",
          "    body: { mode: \"raw\", raw: JSON.stringify({ title: newTitle }) }",
          "  }, function (err, res) {",
          "    console.log(\"[setup] delete\", slug, \"->\", newTitle, res && res.code);",
          "    pm.variables.set(\"SLUG_NAME\", newTitle);",
          "    done(newTitle);",
          "  });",
          "}",
          "",
          "function addWebhook(scriptId, done) {",
          "  pm.sendRequest({",
          "    url: baseUrl + \"/scripts/\" + projectId + \"/\" + scriptId + \"/trigger\",",
          "    method: \"POST\",",
          "    header: headers,",
          "    body: { mode: \"raw\", raw: JSON.stringify({ triggerType: \"webhook\", type: \"add\" }) }",
          "  }, function (err, res) {",
          "    console.log(\"[setup] webhook\", res && res.code);",
          "    done();",
          "  });",
          "}",
          "",
          "function addPreprocess(scriptId, done) {",
          "  pm.sendRequest({",
          "    url: baseUrl + \"/scripts/\" + projectId + \"/\" + scriptId + \"/trigger/preprocess\",",
          "    method: \"POST\",",
          "    header: headers,",
          "    body: { mode: \"raw\", raw: JSON.stringify({",
          "      preProcess: { type: \"function\", code: \"return context.trigger\" },",
          "      loops: { loopsEnabled: false },",
          "      preCondition: null,",
          "      preProcessFilter: null",
          "    }) }",
          "  }, function (err, res) {",
          "    console.log(\"[setup] preprocess\", res && res.code);",
          "    done();",
          "  });",
          "}",
          "",
          "function bindStep(step) {",
          "  pm.variables.set(\"stepId\", step.stepId);",
          "  pm.variables.set(\"SLUG_NAME\", step.title);",
          "  pm.variables.set(\"stepTitle\", step.title);",
          "  pm.environment.set(\"SLUG_NAME\", step.title);",
          "}",
          "",
          "createScript(function (scriptId) {",
          "  if (setup === \"script\") {",
          "    const explicitSlug = pm.iterationData.get(\"SLUG_NAME\");",
          "    if (explicitSlug) {",
          "      pm.variables.set(\"SLUG_NAME\", explicitSlug);",
          "      pm.environment.set(\"SLUG_NAME\", explicitSlug);",
          "    }",
          "    return;",
          "  }",
          "",
          "  if (setup === \"functionStep\" || setup === \"activeFunctionStep\" || setup === \"inactiveFunctionStep\" || setup === \"deletedFunctionStep\") {",
          "    createStep(scriptId, { prefix: \"Fn\" }, function (step) {",
          "      bindStep(step);",
          "      if (setup === \"functionStep\") return;",
          "      updateStep(scriptId, step, \"return true\", function () {",
          "        if (setup === \"activeFunctionStep\") return;",
          "        if (setup === \"inactiveFunctionStep\") {",
          "          changeStatus(scriptId, step.title, \"INACTIVE\", function () {});",
          "          return;",
          "        }",
          "        if (setup === \"deletedFunctionStep\") {",
          "          deleteStep(scriptId, step.title, function () {});",
          "        }",
          "      });",
          "    });",
          "    return;",
          "  }",
          "",
          "  if (setup === \"ifBlockStep\") {",
          "    createStep(scriptId, { type: \"ifBlock\", prefix: \"IfBlock\" }, function (step) {",
          "      bindStep(step);",
          "    });",
          "    return;",
          "  }",
          "",
          "  if (setup === \"twoFunctionSteps\") {",
          "    createStep(scriptId, { title: \"Step_One\" }, function (s1) {",
          "      createStep(scriptId, { title: \"Step_Two\" }, function (s2) {",
          "        const target = pm.iterationData.get(\"targetStep\") || pm.iterationData.get(\"SLUG_NAME\") || \"Step_Two\";",
          "        pm.variables.set(\"SLUG_NAME\", target);",
          "        pm.environment.set(\"SLUG_NAME\", target);",
          "        pm.variables.set(\"stepId\", target === \"Step_One\" ? s1.stepId : s2.stepId);",
          "      });",
          "    });",
          "    return;",
          "  }",
          "",
          "  if (setup === \"webhookTrigger\") {",
          "    addWebhook(scriptId, function () {});",
          "    return;",
          "  }",
          "",
          "  if (setup === \"preprocess\") {",
          "    addWebhook(scriptId, function () {",
          "      addPreprocess(scriptId, function () {});",
          "    });",
          "  }",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const rawExpected = pm.iterationData.get(\"expectedStatus\");",
          "const expectedStatus = (rawExpected === undefined || rawExpected === null || rawExpected === \"\") ? 200 : Number(rawExpected);",
          "",
          "pm.test(\"Status code is correct\", () => {",
          "    pm.response.to.have.status(expectedStatus);",
          "});",
          "",
          "const maxMs = pm.iterationData.get(\"maxResponseMs\") || 30000;",
          "pm.test(\"Response time within limit\", () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(maxMs);",
          "});",
          "",
          "if (expectedStatus === 200 || expectedStatus === 201) {",
          "    pm.test(\"Response is JSON\", () => {",
          "        pm.response.to.be.json;",
          "    });",
          "    pm.test(\"success is true\", () => {",
          "        const json = pm.response.json();",
          "        pm.expect(json.success === true || json.success === undefined || json.message).to.be.ok;",
          "    });",
          "} else {",
          "    pm.test(\"Error message exists\", () => {",
          "        const json = pm.response.json();",
          "        pm.expect(json.message || json.error).to.exist;",
          "    });",
          "}"
        ]
      }
    }
  ]
}
