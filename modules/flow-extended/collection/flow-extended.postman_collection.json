{
  "info": {
    "_postman_id": "03cde248-371a-45c4-a034-3ad53484c05c",
    "name": "flow-extended-apis",
    "description": "Extended flow APIs. Each request can run independently via collection prerequest setup (creates scri* script / func* steps as needed). Data field `setup` controls deps: none | script | functionStep | activeFunctionStep | inactiveFunctionStep | deletedFunctionStep | ifBlockStep | twoFunctionSteps | webhookTrigger | preprocess.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Script",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const scriptTitle = pm.iterationData.get(\"scriptTitle\");",
              "if (scriptTitle === undefined || scriptTitle === null || scriptTitle === \"\") {",
              "  const req = String(pm.info.requestName || \"CreateScript\").replace(/[^a-zA-Z0-9]+/g, \"_\");",
              "  const cse = String(pm.iterationData.get(\"case\") || \"script\").replace(/[^a-zA-Z0-9]+/g, \"_\");",
              "  pm.variables.set(\"scriptTitle\", [\"Dep\", req, cse].join(\"_\").substring(0, 80));",
              "} else {",
              "  pm.variables.set(\"scriptTitle\", scriptTitle);",
              "}",
              "pm.variables.set(\"scriptId\", \"scri\" + Math.random().toString(36).substring(2, 10));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{scriptTitle}}\",\n  \"identifier\": \"{{scriptId}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{BASE_URL}}/projects/{{project_id}}/scripts",
          "host": ["{{BASE_URL}}"],
          "path": ["projects", "{{project_id}}", "scripts"]
        },
        "description": "Creates a flow script. identifier must start with scri. Success = 201."
      },
      "response": []
    },
    {
      "name": "Create Step",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stepIdRaw = pm.iterationData.get(\"stepId\");",
              "const stepId = (stepIdRaw === undefined || stepIdRaw === null || stepIdRaw === \"\")",
              "  ? (\"func\" + Math.random().toString(36).substring(2, 10))",
              "  : stepIdRaw;",
              "const stepTitle = pm.iterationData.get(\"stepTitle\");",
              "const title = (stepTitle === undefined || stepTitle === null) ? (\"Step_\" + Math.random().toString(36).substring(2, 8)) : stepTitle;",
              "const body = {",
              "  type: pm.iterationData.get(\"stepType\") || \"function\",",
              "  title: title,",
              "  orderGroup: pm.iterationData.get(\"orderGroup\") || \"root\",",
              "  scriptId: pm.variables.get(\"scriptId\") || pm.environment.get(\"scriptId\"),",
              "  stepId: stepId",
              "};",
              "pm.variables.set(\"stepId\", stepId);",
              "pm.variables.set(\"stepTitle\", title);",
              "pm.variables.set(\"requestBody\", JSON.stringify(body));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{requestBody}}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{BASE_URL}}/scripts/{{project_id}}/{{scriptId}}/stepv2",
          "host": ["{{BASE_URL}}"],
          "path": ["scripts", "{{project_id}}", "{{scriptId}}", "stepv2"]
        },
        "description": "createNewStepV2Drafted → 200. setup=script. stepId must start with func (max 12 chars)."
      },
      "response": []
    },
    {
      "name": "Update Step",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const slug = pm.variables.get(\"SLUG_NAME\") || pm.iterationData.get(\"SLUG_NAME\") || pm.environment.get(\"SLUG_NAME\");",
              "const stepTitle = pm.iterationData.get(\"stepTitle\");",
              "const title = (stepTitle === undefined || stepTitle === null || stepTitle === \"\") ? slug : stepTitle;",
              "const body = {",
              "  type: pm.iterationData.get(\"stepType\") || \"function\",",
              "  title: title,",
              "  code: pm.iterationData.get(\"code\"),",
              "  stepId: pm.variables.get(\"stepId\") || pm.iterationData.get(\"stepId\"),",
              "  org_id: pm.environment.get(\"org_id\"),",
              "  project_id: pm.environment.get(\"project_id\"),",
              "  calculateDetailedVariables: false",
              "};",
              "pm.variables.set(\"SLUG_NAME\", slug);",
              "pm.variables.set(\"requestBody\", JSON.stringify(body));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{requestBody}}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{BASE_URL}}/scripts/{{scriptId}}/stepv2/{{SLUG_NAME}}",
          "host": ["{{BASE_URL}}"],
          "path": ["scripts", "{{scriptId}}", "stepv2", "{{SLUG_NAME}}"]
        },
        "description": "updateStepV2 → 201. setup=functionStep (or script for missing-slug negatives)."
      },
      "response": []
