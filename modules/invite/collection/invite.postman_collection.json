{
  "info": {
    "_postman_id": "c3d8e5a1-4f2b-4d9e-8a11-invitemod00001",
    "name": "viasocket-invite",
    "description": "ViaSocket Invite Member API collection (module: invite). Route: POST /orgs/:orgId/invite (invite_routes.js).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Invite",
      "item": [
        {
          "name": "Invite Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{body}}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/orgs/{{orgId}}/invite",
              "host": ["{{BASE_URL}}"],
              "path": ["orgs", "{{orgId}}", "invite"]
            }
          },
          "response": []
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [""]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expectedStatus = pm.iterationData.get(\"expectedStatus\") || 200;\r",
              "\r",
              "pm.test(\"Status code is correct\", () => {\r",
              "    pm.response.to.have.status(expectedStatus);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time < 10s\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(10000);\r",
              "});\r",
              "\r",
              "if (expectedStatus >= 200 && expectedStatus < 300) {\r",
              "    pm.test(\"Response is JSON\", () => {\r",
              "        pm.response.to.be.json;\r",
              "    });\r",
              "} else {\r",
              "    pm.test(\"Error message exists\", () => {\r",
              "        pm.expect(pm.response.json().message).to.exist;\r",
              "    });\r",
              "}\r",
              ""
            ]
          }
        }
      ]
    }
  ]
}
