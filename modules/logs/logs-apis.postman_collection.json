  },
  "item": [
    {
      "name": "Get all logs by Script Id",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "proxy_auth_token",
            "value": "{{proxy_auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/logs/orgId/{{orgId}}?scriptId={{scriptId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "logs",
            "orgId",
            "{{orgId}}"
          ],
          "query": [
            {
              "key": "scriptId",
              "value": "{{scriptId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "process bulk logs",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "proxy_auth_token",
            "value": "{{proxy_auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/logs/projectid/{{project_id}}/scriptid/{{scriptId}}/run-logs?filter=%7B%7D",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "logs",
            "projectid",
            "{{project_id}}",
            "scriptid",
            "{{scriptId}}",
            "run-logs"
          ],
          "query": [
            {
              "key": "filter",
              "value": "%7B%7D"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get logs by flow hit id",
      "request": {
        "method": "GET",
