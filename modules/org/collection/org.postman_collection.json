        {
          "name": "update an organization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set update name: random if not provided, unique suffix if provided, empty string passed as-is\r",
                  "const updateOrg = pm.iterationData.get(\"updateOrg\");\r",
                  "if (updateOrg === undefined || updateOrg === null) {\r",
                  "  const randomOrgName = \"Org_\" + Math.random().toString(36).substring(2, 8) + \"_\" + Date.now();\r",
                  "  pm.variables.set(\"updateOrg\", randomOrgName);\r",
                  "} else if (updateOrg === \"\") {\r",
                  "  pm.variables.set(\"updateOrg\", \"\");\r",
                  "} else {\r",
                  "  pm.variables.set(\"updateOrg\", updateOrg + \"_\" + Math.random().toString(36).substring(2, 6));\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\":\"{{updateOrg}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/orgs/{{update_org_id}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "orgs",
                "{{update_org_id}}"
              ]
            }
          },
          "response": []
