  "item": [
    {
      "name": "org",
      "item": [
        {
          "name": "createorg",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set org name: random if not provided, unique suffix if provided, empty string passed as-is\r",
                  "const nameOrg = pm.iterationData.get(\"nameOrg\");\r",
                  "if (nameOrg === undefined || nameOrg === null) {\r",
                  "  const randomOrgName = \"Org_\" + Math.random().toString(36).substring(2, 8) + \"_\" + Date.now();\r",
                  "  pm.variables.set(\"nameOrg\", randomOrgName);\r",
                  "} else if (nameOrg === \"\") {\r",
                  "  pm.variables.set(\"nameOrg\", \"\");\r",
                  "} else {\r",
                  "  pm.variables.set(\"nameOrg\", nameOrg + \"_\" + Math.random().toString(36).substring(2, 6));\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{nameOrg}}\",\r\n  \"timezone\": \"+05:30\",\r\n  \"meta\": {\r\n    \"domainUrl\": \"\",\r\n    \"timezoneIdentifier\": \"Asia/Kolkata\",\r\n    \"preferred_industry\": null\r\n  }\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/orgs/createOrg",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "orgs",
                "createOrg"
              ]
            }
          },
          "response": []
        },
