        {
          "name": "add user to org",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Only generate a random email if the data file did not provide one\r",
                  "const newusermail = pm.iterationData.get(\"newusermail\");\r",
                  "if (newusermail === undefined || newusermail === null) {\r",
                  "  const randommail = \"randomMail_\" + Math.random().toString(36).substring(2, 8) + \"_\" + Date.now();\r",
                  "  pm.variables.set(\"newusermail\", randommail + \"@gmail.com\");\r",
                  "} else {\r",
                  "  pm.variables.set(\"newusermail\", newusermail);\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"user\":{\r\n        \"email\": \"{{newusermail}}\"\r\n    }\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/orgs/adduser",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "orgs",
                "adduser"
              ]
            }
          },
          "response": []
        },
