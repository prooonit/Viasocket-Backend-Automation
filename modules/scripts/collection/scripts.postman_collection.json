        {
          "name": "Create Script",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Only generate a random title if the data file did not provide one\r",
                  "const scriptTitle = pm.iterationData.get(\"scriptTitle\");\r",
                  "if (scriptTitle === undefined || scriptTitle === null) {\r",
                  "  const randomTitle = \"workflow_\" + Math.random().toString(36).substring(2, 8) + \"_\" + Date.now();\r",
                  "  pm.variables.set(\"scriptTitle\", randomTitle);\r",
                  "} else {\r",
                  "  pm.variables.set(\"scriptTitle\", scriptTitle);\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"{{scriptTitle}}\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/projects/{{project_id}}/scripts",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "scripts"
              ]
            },
            "description": "It is possible to create a script i.e workflow without a collection, but it is still asking for the project id in url."
          },
          "response": []
        },
