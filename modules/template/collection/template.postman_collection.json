{
  "info": {
    "_postman_id": "5ac244a7-b6e7-4bf3-a069-966b7867adb2",
    "name": "viasocket-template",
    "description": "ViaSocket template API collection (split from viacollection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Template",
      "item": [
        {
          "name": "Get Template By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/templates/get/{{templateId}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "templates",
                "get",
                "{{templateId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get all Templates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/templates/org_id/get-all-templates",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "templates",
                "get-all-templates"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update template category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"category\": {{categoryJson}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/templates/update-template-category/{{scriptId}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "templates",
                "update-template-category",
                "{{scriptId}}"
              ]
            }
          },
          "response": []
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "const expectedStatus = pm.iterationData.get(\"expectedStatus\") || 200;\r",
              "\r",
              "pm.test(\"Status code is correct\", () => {\r",
              "    pm.response.to.have.status(expectedStatus);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time < 5s\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});\r",
              "\r",
              "if (expectedStatus === 200) {\r",
              "    pm.test(\"Response is JSON\", () => {\r",
              "        pm.response.to.be.json;\r",
              "    });\r",
              "} else {\r",
              "    pm.test(\"Error message exists\", () => {\r",
              "        pm.expect(pm.response.json().message).to.exist;\r",
              "    });\r",
              "}\r",
              ""
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "scriptTitle",
      "value": "",
      "type": "default"
    }
  ]
}