{
  "info": {
    "_postman_id": "5ac244a7-b6e7-4bf3-a069-966b7867adb2",
    "name": "viasocket-users",
    "description": "ViaSocket users API collection (split from viacollection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/users/me",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "SSO Register",
          "request": {
            "method": "GET",
            "header": []
          },
          "response": []
        },
        {
          "name": "Update User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomName = \"User_\" + Math.random().toString(36).substring(2, 8) + \"_\" + Date.now();\r",
                  "pm.variables.set(\"Updatedname\", randomName);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "proxy_auth_token",
                "value": "{{proxy_auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"user\":{\r\n        \"name\":\"{{Updatedname}}\"\r\n    }\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://routes.msg91.com/api/c/updateUser",
              "protocol": "https",
              "host": [
                "routes",
                "msg91",
                "com"
              ],
              "path": [
                "api",
                "c",
                "updateUser"
              ]
            }
          },
          "response": []
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "const expectedStatus = pm.iterationData.get(\"expectedStatus\") || 200;\r",
              "\r",
              "pm.test(\"Status code is correct\", () => {\r",
              "    pm.response.to.have.status(expectedStatus);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time < 5s\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});\r",
              "\r",
              "if (expectedStatus === 200) {\r",
              "    pm.test(\"Response is JSON\", () => {\r",
              "        pm.response.to.be.json;\r",
              "    });\r",
              "} else {\r",
              "    pm.test(\"Error message exists\", () => {\r",
              "        pm.expect(pm.response.json().message).to.exist;\r",
              "    });\r",
              "}\r",
              ""
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "scriptTitle",
      "value": "",
      "type": "default"
    }
  ]
}