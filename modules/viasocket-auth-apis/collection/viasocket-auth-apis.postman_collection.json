{
  "info": {
    "_postman_id": "a3e5c112-7d2b-4d9a-9e14-viasocketauth01",
    "name": "viasocket-auth-apis",
    "description": "ViaSocket auth-data + viasocket-auth API automation. Routes are served from /viasocket-auth/v1 (viasocket_auth_routes.js) and /authtoken (authdata_routes.js).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AuthApis",
      "item": [
        {
          "name": "Get All Auths By Org",
          "request": {
            "method": "GET",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/viasocket-auth/v1/get-all-auths",
              "host": ["{{BASE_URL}}"],
              "path": ["viasocket-auth", "v1", "get-all-auths"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Auth",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/authtoken/org/{{org_id}}/auth/{{auth_id}}",
              "host": ["{{BASE_URL}}"],
              "path": ["authtoken", "org", "{{org_id}}", "auth", "{{auth_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Auth Description",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"{{description}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/authtoken/org/{{org_id}}/auth/{{authIdToUpdate}}",
              "host": ["{{BASE_URL}}"],
              "path": ["authtoken", "org", "{{org_id}}", "auth", "{{authIdToUpdate}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Flows Of Auth",
          "request": {
            "method": "GET",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/authtoken/usedin/{{getflowsofauthid}}",
              "host": ["{{BASE_URL}}"],
              "path": ["authtoken", "usedin", "{{getflowsofauthid}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Auth Info",
          "request": {
            "method": "GET",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/authtoken/authInfo/{{auth_id}}",
              "host": ["{{BASE_URL}}"],
              "path": ["authtoken", "authInfo", "{{auth_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Is Auth Valid",
          "request": {
            "method": "GET",
            "header": [
              { "key": "proxy_auth_token", "value": "{{proxy_auth_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/authtoken/authvalid/{{auth_id}}",
              "host": ["{{BASE_URL}}"],
              "path": ["authtoken", "authvalid", "{{auth_id}}"]
            }
          },
          "response": []
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [""]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expectedStatus = pm.iterationData.get(\"expectedStatus\") || 200;\r",
              "\r",
              "pm.test(\"Status code is correct\", () => {\r",
              "    pm.response.to.have.status(expectedStatus);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time < 10s\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(10000);\r",
              "});\r",
              "\r",
              "if (expectedStatus === 200) {\r",
              "    pm.test(\"Response is JSON\", () => {\r",
              "        pm.response.to.be.json;\r",
              "    });\r",
              "} else if (expectedStatus === 400) {\r",
              "    pm.test(\"Error message exists\", () => {\r",
              "        pm.expect(pm.response.json().message).to.exist;\r",
              "    });\r",
              "} else if (expectedStatus === 401) {\r",
              "    pm.test(\"Unauthorized message present\", () => {\r",
              "        const body = pm.response.json();\r",
              "        pm.expect(body.message || \"\").to.match(/unauthorized/i);\r",
              "    });\r",
              "}\r",
              ""
            ]
          }
        }
      ]
    }
  ]
}
