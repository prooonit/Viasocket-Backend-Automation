  "item": [
    {
      "name": "get all connections of an org",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "proxy_auth_token",
            "value": "{{proxy_auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/viasocket-auth/v1/get-all-auths",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "viasocket-auth",
            "v1",
            "get-all-auths"
          ]
        }
      },
      "response": []
    },
    {
      "name": "delete Unused connection Data",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "proxy_auth_token",
            "value": "{{proxy_auth_token}}"
          }
        ],
        "url": {
