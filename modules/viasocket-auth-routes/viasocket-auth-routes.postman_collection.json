          "host": [
            "{{base_url}}"
          ],
          "path": [
            "authtoken",
            "org",
            "{{orgId}}",
            "auth",
            "{{auth_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "update connection /auth",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "proxy_auth_token",
            "value": "{{proxy_auth_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"description\": \"moved to project scope\",\n    \"old_access_level_id\": \"{{orgId}}\",\n    \"access_level_id\": \"{{project_id}}\"\n  }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/authtoken/org/{{orgId}}/auth/{{authIdToUpdate}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "authtoken",
            "org",
            "{{orgId}}",
            "auth",
            "{{authIdToUpdate}}"
          ]
        }
      },
      "response": []
    },
